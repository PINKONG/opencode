{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WisCode",
  "identifier": "ai.wiscode.desktop",
  "bundle": {
    "createUpdaterArtifacts": true,
    "externalBin": ["sidecars/wiscode-cli", "sidecars/wiscode-node"],
    "icon": [
      "icons/prod/32x32.png",
      "icons/prod/128x128.png",
      "icons/prod/128x128@2x.png",
      "icons/prod/icon.icns",
      "icons/prod/icon.ico"
    ],
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": ["-ExecutionPolicy", "Bypass", "-File", "../../../script/sign-windows.ps1", "%1"]
      },
      "nsis": {
        "installerIcon": "icons/prod/icon.ico",
        "headerImage": "assets/nsis-header.bmp",
        "sidebarImage": "assets/nsis-sidebar.bmp"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/metainfo/ai.wiscode.desktop.metainfo.xml": "release/appstream.metainfo.xml"
        }
      },
      "rpm": {
        "compression": {
          "type": "none"
        }
      }
    }
  },
  "plugins": {
      "updater": {
        "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwQTJEMDBENDY5QTdEN0MKUldSOGZacEdEZENpZ0pZdmpLSjdwWjY1N0wyZ0piNDZkeGhZN3VSaVpmZ2dnMVBSUXNOc0JqSWYK",
      "endpoints": ["https://github.com/PINKONG/opencode/releases/latest/download/latest.json"]
      }
    }
  }
