{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WisCode Beta",
  "identifier": "ai.wiscode.desktop.beta",
  "bundle": {
    "createUpdaterArtifacts": true,
    "externalBin": ["sidecars/wiscode-cli", "sidecars/wiscode-node"],
    "icon": [
      "icons/beta/32x32.png",
      "icons/beta/128x128.png",
      "icons/beta/128x128@2x.png",
      "icons/beta/icon.icns",
      "icons/beta/icon.ico"
    ],
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": ["-ExecutionPolicy", "Bypass", "-File", "../../../script/sign-windows.ps1", "%1"]
      },
      "nsis": {
        "installerIcon": "icons/beta/icon.ico",
        "installerHooks": "release/nsis-installer-hooks.nsh"
      }
    },
    "linux": {
      "rpm": {
        "compression": {
          "type": "none"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwQTJEMDBENDY5QTdEN0MKUldSOGZacEdEZENpZ0pZdmpLSjdwWjY1N0wyZ0piNDZkeGhZN3VSaVpmZ2dnMVBSUXNOc0JqSWYK",
      "endpoints": ["https://github.com/anomalyco/opencode-beta/releases/latest/download/latest.json"]
    }
  }
}
